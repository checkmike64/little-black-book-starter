# Public Supabase browser values. These are safe to expose because RLS gates access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
# Optional defense-in-depth pin for an established deployment. When set, it
# must equal SUPABASE_PROJECT_REF. Use a different value for every client.
# EXPECTED_SUPABASE_PROJECT_REF=your-project-ref
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy fallback while testing older Supabase projects:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Server-only key. Never expose this in browser code.
# Used by gateway routes, scheduled jobs, imports, and Claude-originated privileged writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only, client-unique capability credentials for Claude. Keep all three
# distinct. The read token can only load research context, the job token can
# only control queued work, and the write token can only call audited intake routes.
CLAUDE_READ_TOKEN=generate-a-long-random-read-token
CLAUDE_JOB_TOKEN=generate-a-different-long-random-job-token
CLAUDE_WRITE_TOKEN=generate-a-long-random-token
# Release-A cutover only: set the cutoff for at most 24 hours. Until then, the
# existing write token also authenticates old read/job callers. Remove after zero use.
# CLAUDE_LEGACY_TOKEN_CUTOFF_AT=2026-08-29T12:00:00Z
# Optional only if a later write-token rotation needs a separate legacy value:
# CLAUDE_LEGACY_TOKEN=

# One isolated Supabase project per client, but we still keep a tenant id for RLS and audit consistency.
DEFAULT_TENANT_ID=tenant-uuid-after-bootstrap

# Server-only comma-separated installer/operator emails that may access setup tools.
OPERATOR_EMAILS=admin@example.com
# Required client-facing concierge address. Keep it separate from login identity.
SUPPORT_EMAIL=support@example.com

# Production URL used to build magic-link callbacks. Set this to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=https://client-little-black-book.vercel.app

# Optional: allow app UI to label the current install.
NEXT_PUBLIC_INSTALL_NAME=Little Black Book

# Notion AI Meeting Notes. Use one public Notion connection in selected-
# workspaces mode so every recording owner authorizes their own workspace.
NOTION_OAUTH_CLIENT_ID=notion-public-connection-client-id
NOTION_OAUTH_CLIENT_SECRET=notion-public-connection-client-secret
NOTION_REDIRECT_URI=https://client-little-black-book.vercel.app/api/integrations/notion/callback
# One-time setup guard: append ?setup_secret=<this value> to the webhook URL
# while Notion sends its verification token, then rotate this value immediately.
NOTION_WEBHOOK_SETUP_SECRET=generate-a-one-time-long-random-token
# Optional emergency override. Normal setup stores Notion's verification token
# in Supabase Vault and reads it only on the server.
# NOTION_WEBHOOK_VERIFICATION_TOKEN=notion-verification-token

# Protects the daily Vercel automation route.
CRON_SECRET=generate-another-long-random-token

# Optional automatic public-content monitoring through Apify.
# Use a dedicated, narrowly scoped server token. Task IDs are configured in
# the private operator Settings page after deployment.
APIFY_API_TOKEN=server-only-apify-api-token
APIFY_WEBHOOK_SECRET=generate-a-long-random-webhook-token

# Optional list and local-business enrichment through your own provider account.
# Keep this key server-only; leave unset when the provider is disabled.
OUTSCRAPER_API_KEY=server-only-outscraper-api-key

# In-app writing and recommendation intelligence through Vercel AI Gateway.
# Vercel deployments use OIDC automatically after AI Gateway is enabled.
# Use a separate server-only Gateway key for local development or CI.
AI_GATEWAY_API_KEY=server-only-vercel-ai-gateway-key
# Optional global model overrides. Keep provider/model Gateway slug format.
# LBB_AI_PRIMARY_MODEL=openai/gpt-5.4
# LBB_AI_FALLBACK_MODEL=anthropic/claude-sonnet-4.6
# Keep false unless matching tenant quota entities have been created in Gateway.
# LBB_AI_TENANT_QUOTAS_ENABLED=false
# Optional task override example:
# LBB_AI_INTRODUCTION_DRAFT_PRIMARY_MODEL=anthropic/claude-sonnet-4.6
