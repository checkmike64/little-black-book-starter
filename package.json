{
  "name": "little-black-book",
  "version": "1.0.0",
  "description": "Self-hosted relationship manager with tier-based keep-in-touch reminders.",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node --experimental-strip-types scripts/validate-deployment-env.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib next.config.ts proxy.ts",
    "test": "node scripts/clean-test-build.mjs && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "rehearsal": "node scripts/install-rehearsal.mjs",
    "evidence:offboarding": "node --experimental-strip-types scripts/generate-offboarding-inventory.ts",
    "evidence:restore": "node --experimental-strip-types scripts/generate-isolated-restore-receipt.ts",
    "backup:export": "node scripts/backup-export.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:verify": "supabase db reset --local && supabase test db --local && pnpm rehearsal && pnpm test",
    "db:stop": "supabase stop",
    "smoke:live": "node scripts/live-smoke.mjs",
    "validate:env": "node --experimental-strip-types scripts/validate-deployment-env.ts --production",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm rehearsal && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "ai": "^7.0.76",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0"
}
